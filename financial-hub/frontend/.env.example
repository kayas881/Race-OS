# Every variable below is actually read somewhere in the codebase.
#
# In local dev, leaving REACT_APP_API_URL unset works via CRA's dev-server proxy
# (relative /api/* requests get forwarded to the backend). In production, where
# frontend and backend usually deploy to different domains (e.g. Vercel + Render),
# this MUST be set to the backend's full origin - otherwise API calls resolve
# against the frontend's own domain and 404.
REACT_APP_API_URL=https://your-backend-domain.com

# Clerk (authentication) - safe to expose to the client, this is the publishable key,
# never the secret key. From dashboard.clerk.com or `clerk env pull` in this directory.
REACT_APP_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
