# Environment variables for Race-OS financial-hub backend.
# Every variable below is actually read somewhere in the codebase - this file is kept
# in sync deliberately; don't add speculative vars nothing reads.

# Server
NODE_ENV=development
PORT=5001
FRONTEND_URL=http://localhost:3000

# Database (MongoDB Atlas or any hosted MongoDB) - REQUIRED in production. If unset,
# development falls back to an ephemeral in-memory database; production refuses to
# start rather than do that silently.
MONGODB_URI=mongodb://localhost:27017/financial-hub

# Auth (Clerk) - from dashboard.clerk.com or `clerk env pull` in this directory
CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key
# From the webhook endpoint created in the Clerk dashboard (or `clerk webhooks listen` for local dev)
CLERK_WEBHOOK_SIGNING_SECRET=whsec_your_signing_secret

# Encryption at rest for stored Plaid access tokens (utils/encryption.js).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace_with_a_64_char_hex_string

# PDF generation (Puppeteer)
DISABLE_PDF_GENERATION=false
# Only needed on hosts without a bundled Chromium (e.g. some Docker/serverless setups)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Plaid
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret_key
PLAID_ENV=sandbox
PLAID_WEBHOOK_URL=https://your-backend-domain.com/api/integrations/plaid/webhook
PLAID_REDIRECT_URI=https://your-frontend-domain.com/integrations/plaid/callback
# Set to 'true' only after PLAID_REDIRECT_URI is registered in the Plaid dashboard
# (Team Settings -> API -> Allowed redirect URIs) - otherwise Plaid rejects link token
# creation for OAuth institutions.
PLAID_REDIRECT_URI_REGISTERED=false

# Google APIs (YouTube)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://your-frontend-domain.com/integrations/youtube/callback

# Twitch API
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret
TWITCH_REDIRECT_URI=https://your-frontend-domain.com/integrations/twitch/callback

# Patreon API
PATREON_CLIENT_ID=your_patreon_client_id
PATREON_CLIENT_SECRET=your_patreon_client_secret
PATREON_REDIRECT_URI=https://your-frontend-domain.com/integrations/patreon/callback

# Email (for notifications and invoices) - EMAIL_SERVICE picks the active provider
EMAIL_SERVICE=resend
RESEND_API_KEY=your_resend_api_key
# SENDGRID_API_KEY=your_sendgrid_api_key
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_gmail_app_password
EMAIL_FROM=your_verified_sender@yourdomain.com
